    "@sanity/demo": "2.0.0",
    "@sanity/icons": "3.7.4",
    "@sanity/image-url": "1.2.0",
    "@sanity/ui": "3.1.7",
    "@sanity/util": "4.10.0",
    "@sanity/vision": "4.10.0",
    "@sanity/visual-editing": "^3.0.5",
    "@tailwindcss/typography": "0.5.19",
    "@vercel/speed-insights": "1.2.0",
    "class-variance-authority": "^0.7.1",
    "classnames": "2.5.1",
    "clsx": "^2.1.1",
    "date-fns": "4.1.0",
    "lucide-react": "^0.544.0",
    "next": "15.5.4",
    "next-sanity": "11.3.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-live-transitions": "0.2.0",
    "rxjs": "7.8.2",
    "sanity": "4.10.0",
    "sanity-plugin-asset-source-unsplash": "4.0.1",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "styled-components": "6.1.19",
