    "eslint-formatter-gha": "1.6.0",
    "eslint-plugin-react-compiler": "npm:eslint-plugin-react-hooks@6.0.0-rc.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "^16.4.0",
    "jiti": "^2.6.0",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
